{
  "name": "termix",
  "productName": "Termix",
  "version": "0.3.0",
  "description": "Central de sessões de agentes de programação em terminal, em glassmorphism.",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "check": "node --check src/main.js && node --check src/preload.js && node --check src/web.js && node --check src/updater.js && node --check src/update-helper.js && node --check src/resources.js && node --check src/open-wrapper.js && node --check src/dock.js && node --check src/dock-preload.js && node --check src/renderer/web.js && node --check src/statusline-wrapper.js && node --check src/hook-wrapper.js && node --check src/renderer/app.js && node --check src/renderer/chat.js && node --check src/chat.js && node --check tools/make-icon.js",
    "dist": "electron-builder --win nsis --x64",
    "release": "electron-builder --win nsis --x64 --publish always"
  },
  "author": "Rocruzta",
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@lydell/node-pty": "^1.2.0-beta.18",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "electron-updater": "^6.8.11"
  },
  "devDependencies": {
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.termix.app",
    "productName": "Termix",
    "copyright": "Rocruzta",
    "asar": false,
    "extraResources": [
      {
        "from": "assets/7za.exe",
        "to": "7za.exe"
      },
      {
        "from": "assets/7za-LICENSE.txt",
        "to": "7za-LICENSE.txt"
      }
    ],
    "publish": {
      "provider": "github",
      "owner": "rocruzta50IND",
      "repo": "termix",
      "releaseType": "release"
    },
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/icon.ico",
      "assets/icon.png",
      "assets/logo-mark.svg",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "artifactName": "Termix-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Termix",
      "deleteAppDataOnUninstall": false,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "language": "1046"
    }
  }
}
